{
  "name": "morseGO Android Studio Dev Container",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "android-studio",
  "workspaceFolder": "/workspace",
  "overrideCommand": false,
  "forwardPorts": [6080, 5900],
  "portsAttributes": {
    "6080": {
      "label": "Android Studio Web GUI",
      "onAutoForward": "openBrowser"
    },
    "5900": {
      "label": "Android Studio VNC",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "vscjava.vscode-java-pack",
        "fwcd.kotlin",
        "vscjava.vscode-gradle",
        "eamodio.gitlens"
      ]
    }
  },
  "remoteUser": "root",
  "postAttachCommand": "echo '=====================================================' && echo 'morseGO Android Studio Dev Container is Ready!' && echo 'Android Studio Web GUI: http://localhost:6080' && echo '====================================================='"
}

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/radio_dark"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="CONFIGURAÇÕES MORSEGO"
            android:textColor="@color/morse_amber"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- WPM Speed -->
        <TextView
            android:id="@+id/tvSettingsWpmLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:text="VELOCIDADE: 15 WPM"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekSettingsWpm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="40"
            android:progress="15" />

        <!-- Tone Pitch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSettingsPitchLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="TOM CW: 700 HZ"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTestTone"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Testar"
                android:textColor="@color/morse_cyan" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekSettingsPitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="600"
            android:progress="300" />

        <!-- Keyer Mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:text="MODO DO MANIPULADOR:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgKeyerMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/rbIambicB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Iambic Mode B (Curtis com memória)"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rbIambicA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Iambic Mode A (Clássico)"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rbStraightKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Straight Key / Manual"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <!-- Sound & Haptics -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:text="Sidetone de Áudio Ativo"
            android:textColor="@color/text_primary" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchHaptics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:checked="true"
            android:text="Vibração Tátil"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnCloseSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/morse_amber"
            android:text="Fechar"
            android:textColor="@color/radio_dark"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>

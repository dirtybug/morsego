<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/radio_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Level Navigation Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPrevLevel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@color/radio_surface_variant"
            android:contentDescription="Nível Anterior"
            android:src="@android:drawable/ic_media_previous" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLevelNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="NÍVEL 1 / 21"
                android:textColor="@color/morse_amber"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNewCharacters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="Novas Letras: E (•)  T (—)"
                android:textColor="@color/morse_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNextLevel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@color/radio_surface_variant"
            android:contentDescription="Próximo Nível"
            android:src="@android:drawable/ic_media_next" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Test Header Banner -->
            <TextView
                android:id="@+id/tvPracticeHeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/morse_amber"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/receive_test_header"
                android:textColor="@color/radio_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Lives Hearts Indicator -->
            <TextView
                android:id="@+id/tvReceiveLives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="❤️❤️❤️"
                android:textColor="@color/morse_amber"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <!-- Questions Progress (Question X/20 • Done: Y/20) -->
            <TextView
                android:id="@+id/tvReceiveProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:fontFamily="monospace"
                android:text="Question 1/20 • Done: 0/20"
                android:textColor="@color/morse_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <ProgressBar
                android:id="@+id/pbReceiveProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:max="20"
                android:progress="0"
                android:progressTint="@color/morse_amber" />

            <!-- Score and Unlocked Info Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPracticeUnlockedInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Characters in test: E, T"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPracticeScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Score: 0 / 20"
                    android:textColor="@color/morse_amber"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Play Audio Big Button Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/radio_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/radio_surface_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <Button
                        android:id="@+id/btnPlayQuestionAudio"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:backgroundTint="@color/radio_surface_variant"
                        android:fontFamily="monospace"
                        android:text="🔊"
                        android:textColor="@color/morse_amber"
                        android:textSize="32sp"
                        app:cornerRadius="45dp"
                        app:strokeColor="@color/morse_amber"
                        app:strokeWidth="2dp" />

                    <TextView
                        android:id="@+id/tvPracticeTapPrompt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/practice_tap_to_listen"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4 Options Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:rowCount="2">

                <Button
                    android:id="@+id/btnOpt1"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/radio_surface_variant"
                    android:fontFamily="monospace"
                    android:text="A"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />

                <Button
                    android:id="@+id/btnOpt2"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/radio_surface_variant"
                    android:fontFamily="monospace"
                    android:text="B"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />

                <Button
                    android:id="@+id/btnOpt3"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/radio_surface_variant"
                    android:fontFamily="monospace"
                    android:text="C"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />

                <Button
                    android:id="@+id/btnOpt4"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/radio_surface_variant"
                    android:fontFamily="monospace"
                    android:text="D"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />
            </GridLayout>

            <!-- Result Feedback & Next Button -->
            <TextView
                android:id="@+id/tvQuizResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/morse_green"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnNextQuestion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/morse_amber"
                android:fontFamily="monospace"
                android:text="@string/practice_next_question"
                android:textColor="@color/radio_dark"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>

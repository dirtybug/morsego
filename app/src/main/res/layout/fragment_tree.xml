<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/radio_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/radio_surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/radio_surface_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTreeLevelTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/tree_header_title"
                    android:textColor="@color/morse_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTreeLevelSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tree_header_subtitle"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/tree_instruction"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Interactive 2D Morse Tree Card with Zoom Controls -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/radio_surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/radio_surface_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Zoom Control Toolbar Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="@string/tree_interactive_title"
                        android:textColor="@color/morse_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Zoom Out Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnZoomOut"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="−"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/radio_surface_variant"
                        app:cornerRadius="8dp" />

                    <!-- Zoom Level Display -->
                    <TextView
                        android:id="@+id/tvZoomLevel"
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="100%"
                        android:textColor="@color/morse_amber"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Zoom In Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnZoomIn"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/radio_surface_variant"
                        app:cornerRadius="8dp" />

                    <!-- Zoom Reset Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnZoomReset"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/tree_zoom_reset"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        app:backgroundTint="@color/radio_surface_variant"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- Compact Morse Tree 2D View -->
                <com.morsego.app.ui.view.MorseTreeView
                    android:id="@+id/morseTreeView"
                    android:layout_width="match_parent"
                    android:layout_height="350dp" />

                <!-- Touch & Navigation Hint -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="2dp"
                    android:paddingBottom="8dp"
                    android:text="@string/tree_zoom_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/radio_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Signal TX Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/radio_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <View
            android:id="@+id/ledTxIndicator"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@color/radio_dark" />

        <TextView
            android:id="@+id/tvTxStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="READ CW (IAMBIC B)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvKeyerWpm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="15 WPM"
            android:textColor="@color/morse_amber"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Morse Buffer Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@color/radio_surface"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/tvBuffer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="BUFFER: —"
            android:textColor="@color/morse_cyan"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Decoded Text Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:backgroundTint="@color/radio_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/radio_surface_variant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="TEXTO DESCODIFICADO:"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCopyText"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Copiar"
                    android:textColor="@color/morse_amber"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnBackspace"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apagar"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnClearText"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Limpar"
                    android:textColor="@color/morse_red"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDecodedOutput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:hint="Toque nas pás físicas ou nos botões virtuais abaixo..."
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="18sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Speed Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/radio_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="WPM:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekWpm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="40"
            android:progress="15" />

        <TextView
            android:id="@+id/tvSeekWpmValue"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="end"
            android:text="15"
            android:textColor="@color/morse_amber"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- On-screen Paddle Buttons -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="monospace"
        android:text="PÁS DE MANIPULAÇÃO (OU USE O HARDWARE TYPE-C):"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="115dp"
        android:splitMotionEvents="true"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFreeDit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/radio_surface"
            android:fontFamily="monospace"
            android:text="DI (•)\nPONTO [ESQ]"
            android:textColor="@color/morse_amber"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="@color/morse_amber"
            app:strokeWidth="2dp" />

        <Button
            android:id="@+id/btnFreeDah"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/radio_surface"
            android:fontFamily="monospace"
            android:text="DAH (—)\nTRAÇO [DIR]"
            android:textColor="@color/morse_cyan"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="@color/morse_cyan"
            app:strokeWidth="2dp" />
    </LinearLayout>

</LinearLayout>
